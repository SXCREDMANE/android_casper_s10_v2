# TWRP recovery.fstab for Casper VIA S10 V2 (MT8127)

/system        ext4    /dev/block/mmcblk0p6        flags=display="System";backup=1;wipeingui
/data          ext4    /dev/block/mmcblk0p8        flags=display="Data";backup=1;wipeingui;encryptable=footer
/cache         ext4    /dev/block/mmcblk0p7        flags=display="Cache";backup=1;wipeingui
/boot          emmc    /dev/bootimg                flags=display="Boot";backup=1;flashimg=1
/recovery      emmc    /dev/recovery               flags=display="Recovery";backup=1;flashimg=1
/logo          emmc    /dev/logo                   flags=display="Logo";backup=1;flashimg=1
/nvram         emmc    /dev/nvram                  flags=display="NVRAM";backup=1
/proinfo       emmc    /dev/pro_info               flags=display="Proinfo";backup=1
/uboot         emmc    /dev/uboot                  flags=display="Uboot/LK";backup=1
/misc          emmc    /dev/misc                   flags=display="Misc"

/external_sd   vfat    /dev/block/mmcblk1p1  /dev/block/mmcblk1    flags=display="Micro SD";storage;wipeingui;removable
/usb-otg       vfat    /dev/block/sda1       /dev/block/sda        flags=display="USB OTG";storage;wipeingui;removable